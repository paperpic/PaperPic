{
  "name": "paperpic-monorepo",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "dev": "pnpm --filter docs dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && stylelint \"**/*.{css,vue}\"",
    "lint:fix": "stylelint \"**/*.{css,vue}\" --fix && eslint . --fix",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-format": "2.0.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-vue": "2.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
